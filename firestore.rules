rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    function signedIn() { return request.auth != null; }
    function active() {
      return signedIn() && !exists(/databases/$(database)/documents/accountDeletionJobs/$(request.auth.uid));
    }
    function childAccess(id) {
      let child = get(/databases/$(database)/documents/children/$(id)).data;
      return active() && child.get('deleting', false) == false
        && (child.userId == request.auth.uid || request.auth.uid in child.get('sharedWith', []));
    }
    function childWriteAccess(id) {
      let child = getAfter(/databases/$(database)/documents/children/$(id)).data;
      return active() && child.get('deleting', false) == false
        && (child.userId == request.auth.uid || request.auth.uid in child.get('sharedWith', []));
    }
    function sameIdentity() {
      return request.resource.data.userId == resource.data.userId
        && request.resource.data.childId == resource.data.childId;
    }
    match /users/{uid} {
      allow read: if signedIn() && request.auth.uid == uid;
      allow create, update: if active() && request.auth.uid == uid;
      // Complete account removal is server-owned, including nested data.
      allow delete: if false;
    }
    match /users/{uid}/{subcollection}/{document=**} {
      allow read: if signedIn() && request.auth.uid == uid;
      allow write: if active() && request.auth.uid == uid
        && !(subcollection in ['mealIdeasUsage', 'weeklyPlanUsage', 'insights']);
    }
    match /children/{id} {
      allow read: if signedIn() && (resource.data.userId == request.auth.uid
        || request.auth.uid in resource.data.get('sharedWith', []));
      allow create: if active() && request.resource.data.userId == request.auth.uid
        && request.resource.data.get('sharedWith', []).size() == 0
        && request.resource.data.get('sharedWithEmails', []).size() == 0
        && request.resource.data.get('sharedWithRoles', {}).size() == 0
        && request.resource.data.get('deleting', false) == false;
      // Both family roles may edit the profile; only server endpoints manage access.
      allow update: if childAccess(id)
        && !request.resource.data.diff(resource.data).affectedKeys().hasAny(
          ['userId', 'sharedWith', 'sharedWithEmails', 'sharedWithRoles', 'ownerEmail', 'deleting']);
      allow delete: if false;
    }
    match /children/{id}/lists/{listId} {
      allow read, write: if childAccess(id);
    }
    match /{collection}/{id} {
      allow read: if collection in ['foodLog', 'bottleLog', 'weightLog'] && signedIn()
        && (resource.data.userId == request.auth.uid || childAccess(resource.data.childId));
      allow create: if collection in ['foodLog', 'bottleLog', 'weightLog'] && active()
        && request.resource.data.userId == request.auth.uid && childWriteAccess(request.resource.data.childId);
      allow update: if collection in ['foodLog', 'bottleLog', 'weightLog'] && active()
        && sameIdentity() && childAccess(resource.data.childId);
      allow delete: if collection in ['foodLog', 'bottleLog', 'weightLog'] && active()
        && resource.data.userId == request.auth.uid && childAccess(resource.data.childId);
    }
    match /inviteCodes/{code} { allow read, write: if false; }
    match /recipes/{id} {
      allow read: if signedIn();
      allow write: if active() && request.auth.token.get('admin', false) == true;
    }
    match /recipeSuggestions/{id} {
      allow create: if active() && request.resource.data.userId == request.auth.uid;
    }
    match /supportRequests/{id} {
      allow create: if active() && request.resource.data.userId == request.auth.uid;
    }
  }
}

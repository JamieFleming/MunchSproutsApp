rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // ── User profile doc ──────────────────────────────────────────────────────
    match /users/{userId} {
      allow read, write: if request.auth != null
        && request.auth.uid == userId;
      // Allow any authenticated user to read user docs (e.g. for sharing lookup)
      allow read: if request.auth != null;
    }

    // ── ALL user subcollections (lists, favouriteRecipes, insights,
    //    mealIdeasUsage, smartRecipes, pushTokens, etc.) ──────────────────────
    match /users/{userId}/{subcollection}/{document=**} {
      allow read, write: if request.auth != null
        && request.auth.uid == userId;
    }

    // ── Children ──────────────────────────────────────────────────────────────
    match /children/{docId} {
      allow read, write, delete: if request.auth != null
        && resource.data.userId == request.auth.uid;
      allow read, update: if request.auth != null
        && resource.data.sharedWith != null
        && request.auth.uid in resource.data.sharedWith;
      allow create: if request.auth != null
        && request.auth.uid == request.resource.data.userId;
    }

    // ── Food log ──────────────────────────────────────────────────────────────
    match /foodLog/{docId} {
      allow read, write: if request.auth != null
        && resource.data.userId == request.auth.uid;
      allow create: if request.auth != null
        && request.auth.uid == request.resource.data.userId;
      allow read, update: if request.auth != null
        && resource.data.childId != null
        && exists(/databases/$(database)/documents/children/$(resource.data.childId))
        && (
          get(/databases/$(database)/documents/children/$(resource.data.childId)).data.userId == request.auth.uid
          ||
          (
            get(/databases/$(database)/documents/children/$(resource.data.childId)).data.sharedWith != null
            && request.auth.uid in get(/databases/$(database)/documents/children/$(resource.data.childId)).data.sharedWith
          )
        );
    }

    // ── Bottle log ────────────────────────────────────────────────────────────
    match /bottleLog/{docId} {
      allow read, write: if request.auth != null
        && resource.data.userId == request.auth.uid;
      allow create: if request.auth != null
        && request.auth.uid == request.resource.data.userId;
      allow read, update: if request.auth != null
        && resource.data.childId != null
        && exists(/databases/$(database)/documents/children/$(resource.data.childId))
        && (
          get(/databases/$(database)/documents/children/$(resource.data.childId)).data.userId == request.auth.uid
          ||
          (
            get(/databases/$(database)/documents/children/$(resource.data.childId)).data.sharedWith != null
            && request.auth.uid in get(/databases/$(database)/documents/children/$(resource.data.childId)).data.sharedWith
          )
        );
    }

    // ── Weight log ────────────────────────────────────────────────────────────
    match /weightLog/{docId} {
      allow read, write: if request.auth != null
        && resource.data.userId == request.auth.uid;
      allow create: if request.auth != null
        && request.auth.uid == request.resource.data.userId;
      allow read, update: if request.auth != null
        && resource.data.childId != null
        && exists(/databases/$(database)/documents/children/$(resource.data.childId))
        && (
          get(/databases/$(database)/documents/children/$(resource.data.childId)).data.userId == request.auth.uid
          ||
          (
            get(/databases/$(database)/documents/children/$(resource.data.childId)).data.sharedWith != null
            && request.auth.uid in get(/databases/$(database)/documents/children/$(resource.data.childId)).data.sharedWith
          )
        );
    }

    // ── Invite codes (family sharing) ─────────────────────────────────────────
    // Written by Cloud Function (generateInviteCode), read by any signed-in user.
    match /inviteCodes/{code} {
      allow read: if request.auth != null;
      allow write: if false; // Cloud Function only
    }

    // ── Recipes — authenticated read, admin-only write ────────────────────────
    match /recipes/{recipeId} {
      allow read: if request.auth != null;
      allow write: if request.auth != null
        && request.auth.token.email == "fleming1411@yahoo.co.uk";
    }

    // ── Recipe suggestions ────────────────────────────────────────────────────
    match /recipeSuggestions/{docId} {
      allow create: if request.auth != null
        && request.auth.uid == request.resource.data.userId;
      allow read, update, delete: if false;
    }

    // ── Support requests ──────────────────────────────────────────────────────
    match /supportRequests/{docId} {
      allow create: if request.auth != null
        && request.auth.uid == request.resource.data.userId;
      allow read, update, delete: if false;
    }

  }
}

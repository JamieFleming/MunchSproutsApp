{
	"expo": {
		"name": "Munch Sprouts Weaning Tracker",
		"slug": "MunchSproutsNative",
		"version": "1.6.0",
		"orientation": "portrait",
		"icon": "./assets/logo.png",
		"userInterfaceStyle": "light",
		"ios": {
			"supportsTablet": true,
			"bundleIdentifier": "com.munchsprouts.app",
			"scheme": "com.googleusercontent.apps.406023036087-4ci5jet3el9aqgnuetadrocdp3d3s2jr",
			"buildNumber": "2",
			"infoPlist": {
				"ITSAppUsesNonExemptEncryption": false
			}
		},
		"android": {
			"googleServicesFile": "./google-services.json",
			"adaptiveIcon": {
				"foregroundImage": "./assets/logo.png",
				"backgroundColor": "#ffffff"
			},
			"package": "com.munchsprouts.app",
			"versionCode": 2,
			"intentFilters": [
				{
					"action": "VIEW",
					"data": [
						{
							"scheme": "com.googleusercontent.apps.406023036087-71leqh6hjhigatatn3akjsvf3ml97eir"
						}
					],
					"category": [
						"BROWSABLE",
						"DEFAULT"
					]
				}
			]
		},
		"web": {
			"favicon": "./assets/favicon.ico"
		},
		"plugins": [
			"expo-secure-store",
			"@react-native-google-signin/google-signin",
			"expo-web-browser",
			"expo-apple-authentication",
			[
				"expo-notifications",
				{
					"icon": "./assets/logo.png",
					"color": "#9b7fe8",
					"sounds": []
				}
			],
			"./plugins/withDisableActivitySaveState",
			"expo-font",
			"expo-sharing",
			"expo-status-bar",
			[
				"expo-splash-screen",
				{
					"image": "./assets/logo.png",
					"resizeMode": "contain",
					"backgroundColor": "#ffffff",
					"imageWidth": 200
				}
			],
			[
				"expo-build-properties",
				{
					"ios": {
						"extraPods": [
							{
								"name": "GoogleUtilities",
								"modular_headers": true
							},
							{
								"name": "RecaptchaInterop",
								"modular_headers": true
							}
						]
					}
				}
			]
		],
		"extra": {
			"eas": {
				"projectId": "add89f65-91f0-442e-986c-364d818892bb"
			}
		},
		"owner": "fleming1411",
		"runtimeVersion": {
			"policy": "fingerprint"
		},
		"updates": {
			"url": "https://u.expo.dev/add89f65-91f0-442e-986c-364d818892bb",
			"checkAutomatically": "NEVER"
		}
	}
}

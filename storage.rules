rules_version = '2';
service firebase.storage {
  match /b/{bucket}/o {

    // Child profile photos — owner only
    match /childPhotos/{userId}/{fileName} {
      allow read, write: if request.auth != null && request.auth.uid == userId;
    }

    // Food log photos — owner only
    match /foodPhotos/{userId}/{fileName} {
      allow read, write: if request.auth != null && request.auth.uid == userId;
    }

    // User profile photos — owner only
    match /profilePhotos/{userId}/{fileName} {
      allow read, write: if request.auth != null && request.auth.uid == userId;
    }

  }
}

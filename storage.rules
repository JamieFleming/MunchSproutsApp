rules_version = '2';
service firebase.storage {
  match /b/{bucket}/o {
    function activeOwner(userId) {
      return request.auth != null && request.auth.uid == userId
        && !firestore.exists(/databases/(default)/documents/accountDeletionJobs/$(userId));
    }

    // Child profile photos — owner only
    match /childPhotos/{userId}/{fileName} {
      allow read: if request.auth != null && request.auth.uid == userId;
      allow write: if activeOwner(userId);
    }

    // Food log photos — owner only
    match /foodPhotos/{userId}/{fileName} {
      allow read: if request.auth != null && request.auth.uid == userId;
      allow write: if activeOwner(userId);
    }

    // User profile photos — owner only
    match /profilePhotos/{userId}/{fileName} {
      allow read: if request.auth != null && request.auth.uid == userId;
      allow write: if activeOwner(userId);
    }

  }
}

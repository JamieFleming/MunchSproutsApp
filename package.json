{
  "name": "munchsproutsnative",
  "version": "1.6.2",
  "main": "index.js",
  "scripts": {
    "start": "expo start",
    "android": "expo run:android",
    "ios": "expo run:ios",
    "web": "expo start --web",
    "test": "node --test tests/*.test.js",
    "lint": "eslint App.js index.js src functions/*.js tests scripts/*.cjs",
    "format:check": "prettier --check App.js index.js \"src/**/*.js\" \"functions/*.js\" \"tests/*.{js,cjs}\" \"tests/rules/*.cjs\" \"scripts/*.cjs\"",
    "format": "prettier --write App.js index.js \"src/**/*.js\" \"functions/*.js\" \"tests/*.{js,cjs}\" \"tests/rules/*.cjs\" \"scripts/*.cjs\"",
    "test:rules": "firebase emulators:exec --config firebase.emulator.json --project demo-munchsprouts --only firestore,storage \"node tests/rules/verify.cjs && node tests/rules/audit.cjs && node tests/rules/server.cjs && node tests/rules/storage.cjs\"",
    "audit:reviewed": "node scripts/checkDependencyAudit.cjs",
    "postinstall": "patch-package"
  },
  "dependencies": {
    "@expo-google-fonts/nunito-sans": "^0.4.2",
    "@expo-google-fonts/plus-jakarta-sans": "^0.4.2",
    "@react-native-async-storage/async-storage": "2.2.0",
    "@react-native-google-signin/google-signin": "16.1.2",
    "expo": "~57.0.31",
    "expo-apple-authentication": "~57.0.2",
    "expo-auth-session": "~57.0.16",
    "expo-build-properties": "~57.0.22",
    "expo-camera": "~57.0.6",
    "expo-crypto": "~57.0.4",
    "expo-dev-client": "~57.0.20",
    "expo-file-system": "~57.0.7",
    "expo-font": "~57.0.4",
    "expo-image-picker": "~57.0.20",
    "expo-notifications": "~57.0.24",
    "expo-print": "~57.0.2",
    "expo-secure-store": "~57.0.4",
    "expo-sharing": "~57.0.24",
    "expo-splash-screen": "~57.0.10",
    "expo-status-bar": "~57.0.1",
    "expo-system-ui": "~57.0.4",
    "expo-updates": "~57.0.26",
    "expo-web-browser": "~57.0.3",
    "firebase": "^12.12.1",
    "react": "19.2.3",
    "react-native": "0.86.3",
    "react-native-purchases": "10.1.0",
    "react-native-safe-area-context": "~5.7.0",
    "react-native-svg": "15.15.4"
  },
  "private": true,
  "devDependencies": {
    "eslint": "^9.39.5",
    "eslint-plugin-react-hooks": "^7.1.1",
    "firebase-admin": "^14.5.0",
    "patch-package": "^8.0.1",
    "prettier": "^3.9.10"
  },
  "engines": {
    "node": ">=22"
  },
  "overrides": {
    "@grpc/grpc-js": "^1.14.5",
    "xcode": {
      "uuid": "^11.1.1"
    }
  }
}
